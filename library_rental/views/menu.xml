<odoo>
    <record id="library_my_loans_action" model="ir.actions.act_window">
        <field name="name">Мої видачі</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="library_rental_menu_root" name="Бібліотека"
              groups="library_rental.group_library_librarian,library_rental.group_library_reader"
              sequence="10"/>
    <menuitem id="library_rental_menu_books" name="Books"
              parent="library_rental_menu_root" action="library_book_action"
              groups="library_rental.group_library_librarian" sequence="10"/>
    <menuitem id="library_rental_menu_copies" name="Copies"
              parent="library_rental_menu_root" action="library_copy_action"
              groups="library_rental.group_library_librarian" sequence="20"/>
    <menuitem id="library_rental_menu_members" name="Members"
              parent="library_rental_menu_root" action="library_member_action"
              groups="library_rental.group_library_librarian" sequence="30"/>
    <menuitem id="library_rental_menu_loans" name="Loans"
              parent="library_rental_menu_root" action="library_loan_action"
              groups="library_rental.group_library_librarian" sequence="40"/>
    <menuitem id="library_rental_menu_my_loans" name="Мої видачі"
              parent="library_rental_menu_root" action="library_my_loans_action"
              groups="library_rental.group_library_reader" sequence="50"/>
</odoo>
